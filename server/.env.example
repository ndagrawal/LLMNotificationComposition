# NotifyCompose Server — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Configuration ──────────────────────────────────────────────────────────
# OpenAI API key (required for LLM composition)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Model to use for message composition
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
COMPOSE_MODEL=gpt-4o-mini

# Model to use for reward scoring
REWARD_MODEL=gpt-4o-mini

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite (default for local dev) — use postgresql+asyncpg://... for production
DATABASE_URL=sqlite+aiosqlite:///./notifycompose.db

# ── Server ──────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ── Pipeline Defaults ───────────────────────────────────────────────────────────
# Maximum LLM candidates to generate per request
MAX_CANDIDATES=5

# Frequency cap: max notifications per user per 24 hours
MAX_NOTIFICATIONS_PER_DAY=3

# Frequency cap: max notifications per user per hour
MAX_NOTIFICATIONS_PER_HOUR=1

# ── CLV Tier Thresholds (percentile) ────────────────────────────────────────────
CLV_PLATINUM_THRESHOLD=95
CLV_GOLD_THRESHOLD=80
CLV_SILVER_THRESHOLD=50

# ── Affinity Decay ──────────────────────────────────────────────────────────────
# Exponential decay rate (λ). Half-life = ln(2)/λ ≈ 7 days at λ=0.1
AFFINITY_DECAY_RATE=0.1

# ── STO Bandit ──────────────────────────────────────────────────────────────────
# Thompson Sampling prior (Beta distribution parameters)
STO_PRIOR_ALPHA=1.0
STO_PRIOR_BETA=1.0
